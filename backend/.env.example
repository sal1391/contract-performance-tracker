# ---- App ----
APP_ENV=local

# ---- Demo mode ----
# Auto-seed reference + demo data at startup when the DB has no contracts.
DEMO_SEED=true
# Built-SPA directory served by FastAPI. Leave empty in local dev (Vite serves the UI);
# the Dockerfile sets STATIC_DIR=/app/static.
STATIC_DIR=

# ---- Database (Snowflake Postgres in prod; plain Postgres locally) ----
# Local dev: the docker-compose Postgres below.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/contracts

# ---- Auth0 ----
# When false (local), auth is bypassed with a dev ADMIN user (see app/auth.py).
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://contracts.api
AUTH0_ALGORITHMS=RS256
# Namespace for custom claims (segment, role_level) per the Auth0 rule/action.
AUTH0_CLAIMS_NAMESPACE=https://example.com/

# ---- CORS (React dev server) ----
CORS_ORIGINS=http://localhost:5173

# ---- Snowflake (read sources + export target) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SANDBOX
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=

# ---- Scheduled jobs (seconds) ----
DIMENSION_SYNC_INTERVAL=86400
MATCHER_INTERVAL=10800
EXPORT_INTERVAL=10800
SCHEDULER_ENABLED=false
